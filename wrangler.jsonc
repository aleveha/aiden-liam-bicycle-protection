{
	"compatibility_date": "2026-05-05",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "aiden-liam-bicycle-protection",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"routes": [
		{
			"pattern": "aidenliamframeprotection.ca",
			"custom_domain": true,
		},
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	// Required for astro:assets `/_image` (Picture/Image). Transform uses env.IMAGES + env.ASSETS.
	"images": {
		"binding": "IMAGES",
	},
	"observability": {
		"enabled": true,
	},
}
