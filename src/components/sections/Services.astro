---
import Card from "~/components/ui/Card.astro";
import Section from "~/components/ui/Section.astro";
---

<Section>
	<p class="typography-headline-accent">Services</p>

	<h2 class="typography-headline-primary text-center text-balance">
		PPF and ceramic coating for road, gravel, and MTB bikes
	</h2>

	<p class="typography-headline-secondary text-center text-balance">
		Full protection. Premium service. For riders who care.
	</p>

	<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-6">
		<Card
			class="aspect-4/3 items-center justify-center bg-[#3b3f46] text-center"
			noBorder
			size="large"
			transparent
		>
			<h3 class="text-text-inverse text-2xl font-bold md:text-3xl">
				Paint protection film
			</h3>
			<p
				class="text-text-inverse text-sm font-medium sm:text-balance md:text-base"
			>
				Custom RideWrap coverage for high-wear zones - perfectly covers
				against chips, rub, and trail debris.
			</p>
		</Card>

		<Card
			class="aspect-4/3 items-center justify-center bg-[#4a4b44] text-center"
			noBorder
			size="large"
			transparent
		>
			<h3 class="text-text-inverse text-2xl font-bold md:text-3xl">
				Ceramic coating
			</h3>
			<p
				class="text-text-inverse text-sm font-medium sm:text-balance md:text-base"
			>
				Hydrophobic gloss, easier washes, and longer-lasting shine on
				protected surfaces.
			</p>
		</Card>
	</div>
</Section>
