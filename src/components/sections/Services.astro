---
import Card from "~/components/ui/Card.astro";
import Section from "~/components/ui/Section.astro";

type ServiceItem = {
	title: string;
	description: string;
};

const items: ServiceItem[] = [
	{
		title: "Paint protection film",
		description:
			"Custom RideWrap coverage for high-wear zones - perfectly covers against chips, rub, and trail debris.",
	},
	{
		title: "Ceramic coating",
		description:
			"Hydrophobic gloss, easier washes, and longer-lasting shine on protected surfaces.",
	},
];
---

<Section id="services">
	<p class="typography-headline-accent">Services</p>

	<h2 class="typography-headline-primary">
		PPF and ceramic coating for road, gravel, and MTB bikes
	</h2>

	<p class="typography-headline-secondary">
		Full protection. Premium service. For riders who care.
	</p>

	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
		{
			items.map(({ title, description }) => (
				<Card
					class="aspect-4/3 items-center justify-center bg-[#1a1d21] text-center"
					noBorder
					size="large"
					transparent
				>
					<h3 class="text-text-inverse text-2xl font-bold md:text-3xl">
						{title}
					</h3>
					<p class="text-text-inverse text-sm font-medium sm:text-balance md:text-base">
						{description}
					</p>
				</Card>
			))
		}
	</div>
</Section>
