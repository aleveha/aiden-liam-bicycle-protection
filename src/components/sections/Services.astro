---
import { Picture } from "astro:assets";
import CeramicCoatingImage from "~/assets/ceramic-coating.jpg";
import PPFImage from "~/assets/ppf.jpg";
import Card from "~/components/ui/Card.astro";
import Section from "~/components/ui/Section.astro";
import {
	HALF_VIEWPORT_IMAGE_SIZES,
	RESPONSIVE_IMAGE_WIDTHS,
} from "~/lib/image";

type ServiceItem = {
	title: string;
	description: string;
	image: ImageMetadata;
};

const items: ServiceItem[] = [
	{
		title: "Paint protection film",
		description:
			"Custom RideWrap coverage for high-wear zones - perfectly covers against chips, rub, and trail debris.",
		image: PPFImage,
	},
	{
		title: "Ceramic coating",
		description:
			"Hydrophobic gloss, easier washes, and longer-lasting shine on protected surfaces.",
		image: CeramicCoatingImage,
	},
];
---

<Section id="services">
	<p class="typography-headline-accent">Services</p>

	<h2 class="typography-headline-primary">
		PPF and ceramic coating for road, gravel, and MTB bikes
	</h2>

	<p class="typography-headline-secondary">
		Full protection. Premium service. For riders who care.
	</p>

	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
		{
			items.map(({ title, description, image }) => (
				<Card
					class="relative aspect-4/3 items-center justify-center overflow-hidden text-center"
					noBorder
					size="large"
					transparent
				>
					<h3 class="text-text-inverse text-2xl font-bold md:text-3xl">
						{title}
					</h3>
					<p class="text-text-inverse text-sm font-medium sm:text-balance md:text-base">
						{description}
					</p>

					<Picture
						alt=""
						class="h-full w-full object-cover"
						formats={["avif", "webp"]}
						loading="lazy"
						pictureAttributes={{
							class: "absolute inset-0 block h-full w-full -z-1 brightness-60",
						}}
						sizes={HALF_VIEWPORT_IMAGE_SIZES}
						src={image}
						widths={RESPONSIVE_IMAGE_WIDTHS}
					/>
				</Card>
			))
		}
	</div>
</Section>
