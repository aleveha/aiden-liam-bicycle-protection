---
import Button from "~/components/ui/Button.astro";
import Section from "~/components/ui/Section.astro";
---

<Section
	class="aspect-2/3 items-center justify-center bg-[#1a1d21] sm:aspect-video"
>
	<p class="typography-headline-accent">Certified RideWrap Installer</p>

	<h1 class="typography-headline-primary text-text-inverse">
		Protect your bike<br />Ride without worry
	</h1>

	<Button class="mt-2 w-fit" href="#contact">Get a quote</Button>
</Section>
