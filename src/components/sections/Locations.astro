---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import InnisfilLocationMapImage from "~/assets/innisfil.webp";
import RichmondHillLocationMapImage from "~/assets/richmond-hill.webp";
import Card from "~/components/ui/Card.astro";
import Link from "~/components/ui/Link.astro";
import Section from "~/components/ui/Section.astro";
import { GOOGLE_BUSINESS_URL } from "~/constants/contact";
import {
	HALF_VIEWPORT_IMAGE_SIZES,
	RESPONSIVE_IMAGE_WIDTHS,
} from "~/lib/image";

type LocationItem = {
	title: string;
	region: string;
	description: string;
	image: ImageMetadata;
};

const items: LocationItem[] = [
	{
		title: "Richmond Hill",
		region: "Ontario, Canada",
		description:
			"Convenient for York Region riders and fast GTA drop-offs.",
		image: RichmondHillLocationMapImage,
	},
	{
		title: "Innisfil",
		region: "Ontario, Canada",
		description:
			"Great option for Simcoe-area riders and nearby pickup requests.",
		image: InnisfilLocationMapImage,
	},
];
---

<Section id="locations">
	<p class="typography-headline-accent">Locations</p>

	<h2 class="typography-headline-primary">
		Two convenient locations for GTA and Simcoe riders
	</h2>

	<p class="typography-headline-secondary">
		Pickup available across Toronto, North York, Vaughan, Markham, Richmond
		Hill, Aurora, and Barrie.
	</p>

	<div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-6">
		{
			items.map(({ title, region, description, image }) => (
				<Card
					class="text-text-inverse relative aspect-4/3 min-h-90 justify-between overflow-hidden"
					noBorder
					size="large"
					transparent
				>
					<div class="flex flex-col gap-3">
						<h3 class="text-2xl font-bold md:text-3xl lg:text-4xl">
							{title}
						</h3>
						<p class="font-semibold">{region}</p>
						<p class="text-sm md:text-base">{description}</p>
					</div>

					<Link
						class="text-text-inverse hover:text-unset w-fit bg-[linear-gradient(currentColor,currentColor)] bg-size-[0%_2px] bg-bottom bg-no-repeat pb-0.5 font-medium transition-all duration-300 hover:bg-size-[100%_2px] motion-reduce:transition-none"
						href={GOOGLE_BUSINESS_URL}
						rel="noopener noreferrer"
						target="_blank"
					>
						Open in Google Maps
					</Link>

					<Picture
						alt=""
						class="h-full w-full object-cover brightness-60"
						decoding="async"
						fallbackFormat="jpeg"
						formats={["avif", "webp"]}
						loading="lazy"
						pictureAttributes={{
							class: "absolute inset-0 -z-1 block h-full w-full",
						}}
						sizes={HALF_VIEWPORT_IMAGE_SIZES}
						src={image}
						widths={RESPONSIVE_IMAGE_WIDTHS}
					/>
				</Card>
			))
		}
	</div>
</Section>
