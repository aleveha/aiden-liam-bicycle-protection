---
import type { ImageMetadata } from "astro";
import type { SvgComponent } from "astro/types";
import Card from "~/components/ui/Card.astro";
import Carousel from "~/components/ui/Carousel.astro";
import Section from "~/components/ui/Section.astro";
import ExternalLinkIcon from "~/components/ui/icons/ExternalLink.astro";
import MapPinCheckIcon from "~/components/ui/icons/MapPinCheck.astro";
import MessagesIcon from "~/components/ui/icons/Messages.astro";
import WranchIcon from "~/components/ui/icons/Wranch.astro";
import { GOOGLE_BUSINESS_URL } from "~/constants/contact";
import { HALF_VIEWPORT_IMAGE_SIZES } from "~/lib/image";
import CeramicCoatingImage from "../Services/ceramic-coating.jpg";
import PPFImage from "../Services/ppf.jpg";

type StepItem = {
	title: string;
	description: string;
	icon: SvgComponent;
};

const steps: StepItem[] = [
	{
		title: "Quote",
		description:
			"Share your bike model and what you want protected.\nWe confirm coverage and pricing before you book.",
		icon: MessagesIcon,
	},
	{
		title: "Drop-off & install",
		description:
			"Typical turnaround ~3 days: degrease and prep, precise film install, settling time, bubble check and fixes, then ceramic coating.",
		icon: WranchIcon,
	},
	{
		title: "Pickup",
		description:
			"Final inspection, care tips, and your bike is ready to roll.",
		icon: MapPinCheckIcon,
	},
];

const howItWorksImports = import.meta.glob<{ default: ImageMetadata }>(
	"./carousel/*.{jpg,jpeg}",
	{
		eager: true,
	},
);
const howItWorksSlides: ImageMetadata[] = Object.entries(howItWorksImports)
	.sort(([pathA], [pathB]) =>
		pathA.localeCompare(pathB, undefined, {
			numeric: true,
			sensitivity: "base",
		}),
	)
	.map(([, mod]) => mod.default);

const carouselSlides = [CeramicCoatingImage, PPFImage, ...howItWorksSlides].map(
	(image) => ({
		src: image,
		sizes: HALF_VIEWPORT_IMAGE_SIZES,
	}),
);
---

<Section id="how-it-works">
	<p class="typography-headline-accent">How It Works</p>

	<h2 class="typography-headline-primary">
		From quote to pickup in about 3 days
	</h2>

	<p class="typography-headline-secondary">
		Preparation, film install with settling time, bubble checks, ceramic
		coating, then a final handoff - so you pick up a bike that's protected
		and ready to ride.
	</p>

	<div class="grid w-full grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-6">
		<div class="flex flex-col gap-4">
			{
				steps.map(({ title, description, icon: Icon }) => (
					<Card class="md:flex-row md:items-center">
						<Icon class="text-accent-primary size-8 shrink-0" />
						<div class="flex flex-col gap-2">
							<h3 class="text-text-primary text-xl font-semibold">
								{title}
							</h3>
							<p class="text-text-secondary">{description}</p>
						</div>
					</Card>
				))
			}
		</div>

		<Carousel
			class="bg-border-primary aspect-4/3 h-full w-full sm:aspect-video"
			slides={carouselSlides}
		/>
	</div>

	<Card
		aria-label="Read 5-star Google reviews"
		as="a"
		class="group hover:border-accent-primary trasition-all relative gap-1.5 duration-200"
		href={GOOGLE_BUSINESS_URL}
		rel="noopener noreferrer"
		target="_blank"
	>
		<div class="flex w-full items-center gap-2 md:justify-start md:gap-2.5">
			<p class="text-accent-primary font-bold lg:text-lg">★★★★★</p>
			<p class="text-text-primary text-sm font-semibold lg:text-base">
				5.0 rating on Google
			</p>
		</div>
		<p class="text-text-secondary text-sm">
			See what riders say about installation quality and turnaround.
		</p>

		<ExternalLinkIcon
			aria-hidden="true"
			class="text-text-primary group-hover:text-accent-primary group-focus-visible:text-accent-primary absolute top-3 right-3 size-6 transition duration-200 motion-reduce:transition-none md:size-7 lg:size-8"
			stroke-width="1.5"
		/>
	</Card>
</Section>
