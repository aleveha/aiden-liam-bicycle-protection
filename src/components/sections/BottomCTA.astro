---
import Button from "~/components/ui/Button.astro";
import Section from "~/components/ui/Section.astro";
---

<Section id="get-started" class="pb-12 md:pb-20">
	<h2 class="typography-headline-primary">
		Ready to protect your bicycle with premium care?
	</h2>

	<p class="typography-headline-secondary">
		Send your bike model and preferred package to get a tailored quote.
