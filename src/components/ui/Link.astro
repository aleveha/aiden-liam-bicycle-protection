---
import type { HTMLAttributes } from "astro/types";
import { cn } from "~/lib/cn";

const { class: className, ...props } = Astro.props as HTMLAttributes<"a">;
---

<a
	class={cn(
		"text-text-primary hover:text-accent-primary transition-colors duration-150",
		className,
	)}
	{...props}
>
	<slot />
</a>
