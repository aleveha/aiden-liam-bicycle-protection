---
import type { HTMLAttributes } from "astro/types";
import { cn } from "~/lib/cn";

type CardSize = "small" | "medium" | "large";

type Props = HTMLAttributes<"article"> & {
	noBorder?: boolean;
	size?: CardSize;
	transparent?: boolean;
};

const {
	class: className,
	noBorder = false,
	size = "medium",
	transparent = false,
	...props
} = Astro.props as Props;
---

<article
	class={cn(
		"flex w-full flex-col",
		{
			"bg-surface-base": !transparent,
			"border-border-primary border": !noBorder,
			"gap-3 rounded-xl px-4.5 py-3.5": size === "small",
			"gap-4 rounded-2xl px-6 py-5": size === "medium",
			"gap-4 rounded-3xl p-7": size === "large",
		},
		className,
	)}
	{...props}
>
	<slot />
</article>
