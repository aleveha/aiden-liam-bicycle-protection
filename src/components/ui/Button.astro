---
import { cn } from "~/lib/cn";

type Props = {
	class?: string;
	disabled?: boolean;
	href?: string;
	type?: "button" | "submit" | "reset";
};

const {
	class: className,
	href,
	type = "button",
	...restProps
} = Astro.props as Props & Record<string, unknown>;

const classes = cn(
	"inline-flex cursor-pointer items-center justify-center rounded-full",
	"bg-accent-primary text-text-inverse text-center",
	"px-8 py-3 text-sm font-bold md:px-9 md:py-3.5 md:text-base lg:px-10 lg:py-4",
	"transition-colors duration-150 hover:brightness-95",
	"disabled:cursor-not-allowed disabled:opacity-60 aria-disabled:cursor-not-allowed aria-disabled:opacity-60",
	className,
);
---

{
	href ? (
		<a
			href={href}
			class={classes}
			aria-disabled={Astro.props.disabled ? "true" : undefined}
			{...restProps}
		>
			<slot />
		</a>
	) : (
		<button
			type={type}
			class={classes}
			disabled={Astro.props.disabled}
			{...restProps}
		>
			<slot />
		</button>
	)
}
