---
import FacebookIcon from "~/components/ui/icons/Facebook.astro";
import InstagramIcon from "~/components/ui/icons/Instagram.astro";
import MapPinnedIcon from "~/components/ui/icons/MapPinned.astro";
import Link from "~/components/ui/Link.astro";
import {
	FACEBOOK_URL,
	GOOGLE_BUSINESS_URL,
	INSTAGRAM_URL,
} from "~/constants/contact";
---

<footer class="border-border-primary w-full border-t">
	<div
		class="mx-auto flex w-full max-w-360 items-center justify-between gap-4 px-5 py-3 md:px-8 md:py-4 lg:px-20 lg:py-5"
	>
		<a
			aria-label="Aiden Liam Bicycle Protection home"
			class="text-text-primary text-sm font-medium md:text-base lg:text-lg"
			href="/"
		>
			Aiden Liam Bicycle Protection
		</a>

		<div class="flex items-center gap-2 lg:gap-5 [&>a]:p-1">
			<Link
				aria-label="Instagram"
				href={INSTAGRAM_URL}
				rel="noopener noreferrer"
				target="_blank"
			>
				<InstagramIcon class="size-4 sm:size-5" />
			</Link>

			<Link
				aria-label="Facebook"
				href={FACEBOOK_URL}
				rel="noopener noreferrer"
				target="_blank"
			>
				<FacebookIcon class="size-4 sm:size-5" />
			</Link>

			<Link
				aria-label="Google Maps — business profile and reviews"
				href={GOOGLE_BUSINESS_URL}
				rel="noopener noreferrer"
				target="_blank"
			>
				<MapPinnedIcon class="size-4 sm:size-5" />
			</Link>
		</div>
	</div>
</footer>
